SELECT 
    pl.id,
    ps.subject AS subjectName,
    b.brand as brandName,
    b.logo as brandLogo,
    pl.name,
    pl.desc,
    pl.price,
    pl.image,
    pl.order,
    pl.regist,
    pl.sell
FROM 
    PRODUCT_LIST pl
INNER JOIN PRODUCT_SUBJECT ps ON ps.id = pl.subject
INNER JOIN PRODUCT_TYPE pt ON pt.id = ps.type
    
INNER JOIN BRANDS b ON b.id = pl.brand
  
  WHERE
    1 = 1
   AND pt.type = 'top'
   AND ps.subject IN (16)
ORDER BY
   pl.regist DESC
LIMIT ?
